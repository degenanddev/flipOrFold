# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web3 — WalletConnect (cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=

# BSC network switch: testnet | mainnet
VITE_BSC_NETWORK=testnet

# BSC RPC (client-side reads)
VITE_REACT_APP_ALCHEMY_KEY_BSC_TESTNET=https://bsc-testnet.infura.io/v3/YOUR_KEY
VITE_REACT_APP_ALCHEMY_KEY_BSC_MAINNET=https://bsc-mainnet.infura.io/v3/YOUR_KEY

# Wallet that receives BNB/tBNB payments
VITE_CRYPTO_TREASURY_ADDRESS=0xYourWallet

# ── Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets) ──
# BSC_NETWORK=testnet          # or mainnet
# BSC_TESTNET_RPC=https://bsc-testnet.infura.io/v3/YOUR_KEY
# BSC_MAINNET_RPC=https://bsc-mainnet.infura.io/v3/YOUR_KEY
#
# When switching to mainnet, also run in Supabase SQL:
# update public.crypto_settings set value = 'mainnet' where key = 'bsc_network';

# SilphCo Analytics — Pokémon market (Card Dex; key is visible in the client bundle)
# VITE_SILPHCO_API_KEY=sk_live_…

# Optional — Card Dex live Renaiss search from browser (uses daily quota; visible in client bundle)
# VITE_RENAISS_API_BASE=https://api.renaissos.com
# VITE_RENAISS_INDEX_URL=https://index.renaissos.com
# VITE_RENAISS_API_KEY=rk_…
# VITE_RENAISS_API_SECRET=rsk_…

# ── Renaiss OS Index API (scripts/sync-renaiss-cards.mjs) ──
# RENAISS_API_BASE=https://api.renaissos.com
# RENAISS_API_KEY=rk_…           # optional — lifts 10k/day partner limit
# RENAISS_API_SECRET=rsk_…
# RENAISS_MAX_CALLS_PER_DAY=9     # default 9 (24 cards each) — saves 1 req buffer on free tier
#
# Server-only (never expose to client):
# SUPABASE_SERVICE_ROLE_KEY=
