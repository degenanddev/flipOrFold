# Supabase — pseudo accounts (trainer name + device id), saves, leaderboard, crypto orders.
# get one from https://supabase.com/dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WalletConnect — web3 wallet link (for premium packs)
# get one from https://cloud.walletconnect.com/dashboard
VITE_WALLETCONNECT_PROJECT_ID = 
VITE_REACT_APP_WALLET_CONNECT_BRIDGE = 

# Infura — BSC RPC (for premium packs)
# get one from https://infura.io/dashboard
VITE_REACT_APP_ALCHEMY_KEY_BSC_MAINNET = 
VITE_REACT_APP_ALCHEMY_KEY_BSC_TESTNET = 
# Crypto treasury address which will receive the premium packs purchases  money (for premium packs)
VITE_CRYPTO_TREASURY_ADDRESS = 

# BSC network (for premium packs) testnet or mainnet
VITE_BSC_NETWORK=

# SilphCo — Card Dex Pokémon and One Piece market tab
# Local dev: VITE_SILPHCO_API_KEY (proxied via /api/silphco to avoid CORS)
# Vercel prod: also set SILPHCO_API_KEY (server-side, no VITE_ prefix)
VITE_SILPHCO_API_KEY=
SILPHCO_API_KEY=

